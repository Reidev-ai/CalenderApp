# Copy this file outside the repository and fill in real production values.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787

# Must match the public frontend origin exactly.
CALENDAR_ALLOWED_ORIGINS=https://example.com

# Keep runtime data outside the web root and outside the Git checkout.
# start-production.sh uses umask 077 so newly created runtime files are private.
CALENDAR_DATA_DIR=/var/lib/calendar
LOG_FILE=/var/log/calendar/app.log
CALENDAR_BACKUP_DIR=/var/backups/calendar

# Set to 1 only when the API is behind a trusted reverse proxy.
CALENDAR_TRUST_PROXY=1

CALENDAR_JSON_BODY_MAX_BYTES=1048576
CALENDAR_MEMO_IMAGE_BODY_MAX_BYTES=14680064
CALENDAR_MEMO_IMAGE_MAX_BYTES=10485760

# Enable after public launch.
CALENDAR_BACKUP_ENABLED=1
CALENDAR_BACKUP_INTERVAL_MINUTES=1440
CALENDAR_BACKUP_RUN_ON_START=1
