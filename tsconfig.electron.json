{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist-electron",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts"]
}
